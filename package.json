{
  "name": "chatlium",
  "version": "0.0.0",
  "private": true,
  "description": "Chatlium: multi-tenant AI support chat (cloud and DevOps portfolio project)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
