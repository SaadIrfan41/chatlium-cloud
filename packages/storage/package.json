{
  "name": "@chatlium/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Object storage interface and its S3 adapter (presigned uploads)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/integration/floci.ts"
  },
