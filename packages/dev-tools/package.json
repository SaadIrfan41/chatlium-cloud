{
  "name": "@chatlium/dev-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Local development helpers (Floci setup). Never deployed.",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc -p .",
    "cognito:setup": "node --env-file=../../.env src/cognito-setup.ts",
    "cognito:check": "node --env-file=../../.env src/cognito-signin-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1164.0"
  },
  "devDependencies": {
    "@chatlium/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "zod": "4.6.7"
  }
}
