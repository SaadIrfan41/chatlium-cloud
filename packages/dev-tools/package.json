{
  "name": "@chatlium/dev-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Local development helpers (Floci setup, dev seed data). Never deployed.",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc -p .",
    "cognito:setup": "node --env-file=../../.env src/cognito-setup.ts",
    "cognito:check": "node --env-file=../../.env src/cognito-signin-check.ts",
    "web:auth-check": "node --env-file=../../.env src/web-auth-check.ts",
    "db:seed-dev": "node --env-file=../../.env src/db-seed-dev.ts",
    "web:workspace-check": "node --env-file=../../.env src/web-workspace-check.ts",
    "s3:setup": "node --env-file=../../.env src/s3-setup.ts",
    "web:upload-check": "node --env-file=../../.env src/web-upload-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1164.0",
    "@chatlium/auth": "workspace:*",
    "@chatlium/crypto": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@chatlium/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "zod": "4.6.7"
  }
}
