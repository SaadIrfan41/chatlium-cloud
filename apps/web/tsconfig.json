{
  "extends": "@chatlium/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2025"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "scripts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.config.ts",
    "*.config.mjs"
  ],
  "exclude": ["node_modules"]
}
