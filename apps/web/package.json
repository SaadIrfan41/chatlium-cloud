{
  "name": "@chatlium/web",
  "version": "0.0.0",
  "private": true,
  "description": "Chatlium dashboard and synchronous API (Next.js App Router)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.ts dev --port 3000",
    "build": "node scripts/next.ts build",
    "start": "node scripts/next.ts start --port 3000",
    "lint": "node scripts/next.ts typegen && oxlint --type-aware --deny-warnings .",
    "typecheck": "node scripts/next.ts typegen && tsc -p .",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@chatlium/auth": "workspace:*",
    "@chatlium/config": "workspace:*",
    "@chatlium/contracts": "workspace:*",
    "@chatlium/crypto": "workspace:*",
    "@chatlium/db": "workspace:*",
    "@chatlium/observability": "workspace:*",
    "@chatlium/queue": "workspace:*",
    "@chatlium/storage": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "openid-client": "6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chatlium/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
