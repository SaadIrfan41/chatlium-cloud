# Copy to .env for local development. .env is gitignored; never commit it.
# These values are for the local Docker containers only. They are not used in AWS.

# PostgreSQL superuser for the local container. Used only for setup and migrations bootstrap.
# The application never connects as this user (it uses chatlium_app, created in Step 1.5).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
POSTGRES_DB=chatlium
POSTGRES_PORT=5432

REDIS_PORT=6379

# Database roles (packages/db, Step 1.5). Generate long random passwords (hex, so no URL escaping).
CHATLIUM_OWNER_PASSWORD=change-me-owner-password-local-only
CHATLIUM_APP_PASSWORD=change-me-app-password-local-only

# Admin connection: used only by `pnpm --filter @chatlium/db db:bootstrap` to create the roles.
DATABASE_ADMIN_URL=postgres://postgres:change-me-local-only@localhost:5432/chatlium
# Owner connection: used only to run migrations.
DATABASE_OWNER_URL=postgres://chatlium_owner:change-me-owner-password-local-only@localhost:5432/chatlium
# Application connection: the only database URL application processes receive.
DATABASE_URL=postgres://chatlium_app:change-me-app-password-local-only@localhost:5432/chatlium

# Local AWS emulation (Floci, docker-compose service `floci`). Dummy credentials: Floci accepts any.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
FLOCI_PORT=4566

# Public base URL of the web app (OIDC callback: <APP_BASE_URL>/api/auth/callback).
APP_BASE_URL=http://localhost:3000

# Cognito (Step 1.9). Run `pnpm --filter @chatlium/dev-tools cognito:setup` to create the pool in
# Floci; it fills these in your .env, including random test-user passwords.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
DEV_USER_A_EMAIL=
DEV_USER_A_PASSWORD=
DEV_USER_B_EMAIL=
DEV_USER_B_PASSWORD=
