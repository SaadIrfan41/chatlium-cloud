# Copy to .env for local development. .env is gitignored; never commit it.
# These values are for the local Docker containers only. They are not used in AWS.

# PostgreSQL superuser for the local container. Used only for setup and migrations bootstrap.
# The application never connects as this user (it uses chatlium_app, created in Step 1.5).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
POSTGRES_DB=chatlium
POSTGRES_PORT=5432

REDIS_PORT=6379
